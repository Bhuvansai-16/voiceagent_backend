# LiveKit â€” https://cloud.livekit.io (free tier, no card)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram â€” https://console.deepgram.com ($200 free credit, no card)
# One key covers both STT (Flux) and TTS (Aura-2).
DEEPGRAM_API_KEY=

# STT provider: deepgram | sarvam | nvidia
STT_PROVIDER=deepgram

# Sarvam — https://dashboard.sarvam.ai. Saaras v4 streaming STT, 22 Indian
# languages plus Indian English. SARVAM_STT_LANGUAGE: en-IN, hi-IN, ... or
# "unknown" to auto-detect.
SARVAM_API_KEY=
SARVAM_STT_LANGUAGE=en-IN

# TTS provider: deepgram | cartesia
TTS_PROVIDER=deepgram
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Cartesia â€” only needed if TTS_PROVIDER=cartesia
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3
CARTESIA_VOICE=

# LLM provider: google | nvidia | nebius | openai | anthropic
# google + https://aistudio.google.com/apikey is the free option.
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Nebius Token Factory — https://tokenfactory.nebius.com. Nemotron 3.5 there is
# LLM_MODEL=nvidia/Nemotron-3_5-Lightning (not the build.nvidia.com spelling).
NEBIUS_API_KEY=

# Service desk backend the agent's tools call (agent/integrations/).
# Any JSON REST API works; field mapping hooks live in agent/integrations/rest.py
# for systems whose payloads differ.
SERVICEDESK_PROVIDER=rest
SERVICEDESK_BASE_URL=http://localhost:8002
SERVICEDESK_API_KEY=
# Auth header formatting for the API key (default: "Authorization: Bearer <key>").
SERVICEDESK_AUTH_HEADER=Authorization
SERVICEDESK_AUTH_SCHEME=Bearer
# Endpoint path templates on the remote system.
SERVICEDESK_EMPLOYEE_PATH=/employees/{id}
SERVICEDESK_TICKETS_PATH=/tickets
SERVICEDESK_CREATE_TICKET_PATH=/tickets
SERVICEDESK_RESET_PATH=/password-reset
# Key that wraps the ticket list in a list-tickets response.
SERVICEDESK_TICKETS_KEY=tickets
SERVICEDESK_TIMEOUT_SECONDS=10

# Telemetry feed for the debug UI (agent/tools.py log_event). Failures are
# swallowed — this never affects a live call.
DEBUG_API_URL=http://localhost:8002

# Flux end-of-turn eagerness. Lower = commits to a turn sooner but cuts people
# off more; higher = more patient but slower.
EAGER_EOT_THRESHOLD=0.4

# Seconds of speech before the agent treats it as a barge-in and stops talking.
# LiveKit's default is 0.5. Plan section 154 asks for ~200ms, so try 0.2 â€” but
# lower values also let coughs and background speech interrupt. Tune by call.
INTERRUPT_MIN_DURATION=0.5

# Composio MCP â€” https://platform.composio.dev (free tier, 20k tool calls/mo, no card)
# Leave COMPOSIO_MCP_URL blank to run without any MCP server attached.
# Format: https://backend.composio.dev/v3/mcp/<server_id>?user_id=<your_user_id>
COMPOSIO_MCP_URL=
COMPOSIO_API_KEY=
# Restrict which Composio tools the model can see. Start read-only â€” an unlisted
# tool cannot be called at all. Blank means every tool on the server is exposed.
# e.g. GMAIL_FETCH_EMAILS,GITHUB_LIST_ISSUES,GOOGLECALENDAR_FIND_EVENT
COMPOSIO_ALLOWED_TOOLS=

# Any additional HTTP MCP servers, comma separated. No auth headers are sent.
EXTRA_MCP_URLS=

# Daytona â€” https://www.daytona.io ($200 compute credits, no card).
# Sandbox for agent-run commands. Credits are not a free tier: they run out, and
# per-second billing on an agent that can loop is a bill that can surprise. Set
# a spend alert before any unattended run. Not wired up yet, see ROADMAP.md.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_SANDBOX_NAME=voice-agent-sandbox

# Tavily â€” https://tavily.com (1,000 searches/month free).
# Measured 475ms warm, 3.1s cold. Used via the Python SDK rather than Tavily's
# hosted MCP, which passes the key as a URL query parameter. See ROADMAP.md.
TAVILY_API_KEY=

# supermemory â€” per-caller memory. Run it locally, nothing leaves the machine:
#   npx supermemory local     then     supermemory-server
# Listens on 6767 and embeds locally with bge-base-en-v1.5, so no cloud, no bill.
# Leave SUPERMEMORY_API_KEY blank to run without memory; recall then no-ops.
SUPERMEMORY_API_KEY=
SUPERMEMORY_BASE_URL=http://localhost:6767
# Recall runs inside the turn, so it is capped hard. Raising this slows every
# reply, including the ones with nothing to recall.
MEMORY_RECALL_TIMEOUT=0.2

# NVIDIA Nemotron OCR v2 & Pinecone Vector Store
NVIDIA_API_KEY=
NVIDIA_OCR_URL=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2
PINECONE_API_KEY=
PINECONE_INDEX_NAME=voiceagent-rag

# ---------------------------------------------------------------------------
# Outbound calling. THIS SPENDS REAL MONEY ON EVERY CALL.
#
# Twilio's REST API places the call and TwiML bridges it into LiveKit over SIP,
# so no Elastic SIP Trunk is needed. These three are the credentials from the
# Twilio console dashboard.
ACCOUNT_SID=
AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# The SIP host of your LiveKit project, from the LiveKit console under
# Telephony. Looks like abc123xyz.sip.livekit.cloud. Not derivable from
# LIVEKIT_URL, so copy it rather than guessing.
LIVEKIT_SIP_HOST=

# Digest auth for the inbound SIP trunk. Pick any username and a long random
# password; they are created on the LiveKit trunk automatically and sent by
# Twilio. Without them the trunk would answer anyone who found it.
SIP_AUTH_USERNAME=voice-agent
SIP_AUTH_PASSWORD=

# Only used for SMS, which this project does not send.
MESSAGING_SERVICE_SID=

# Hard stop on call length, enforced by LiveKit rather than by the agent, so it
# still applies if the agent hangs or the worker dies mid-call. This is the
# difference between a bug and a bill.
MAX_CALL_SECONDS=300
RINGING_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Neon Postgres. Use the POOLED connection string - the hostname contains
# "-pooler". It fronts PgBouncer and handles up to 10k client connections.
#
# Schema migrations need the DIRECT endpoint instead; the code derives it by
# removing "-pooler", so only this one value has to be set.
NEON_CONNECTION_URI=

# postgres (default) or memory. "memory" runs the API with no database at all.
STORE_BACKEND=postgres
DB_POOL_MAX=8

# ---------------------------------------------------------------------------
# Neon Object Storage, S3-compatible. From the Neon console; the keys are
# generated once and shown once. A value still wrapped in <angle brackets> is
# the placeholder, not a key - the code refuses those rather than letting every
# call fail as InvalidAccessKeyId.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=assets
S3_PRESIGN_TTL=3600

# ---------------------------------------------------------------------------
# Neon Auth. AUTH_URL is the base, e.g.
#   https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
#
# JWKS_URL is optional: it defaults to <AUTH_URL>/.well-known/jwks.json, which
# is where the keys actually live. Setting it equal to AUTH_URL gives a 404 and
# a 401 on every request, so the code corrects that case rather than obeying it.
#
# Tokens are signed with EdDSA (Ed25519), not RS256.
AUTH_URL=
JWKS_URL=
